# ──────────────────────────────────────────────────────────────
# FRONTEND / WEB env (Vercel). This app is UI only: no bot, no DB,
# no wallet keys, no trading. It talks to the backend over HTTP.
# ──────────────────────────────────────────────────────────────

# Public (inlined into the browser bundle)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=BetOneTradingBot   # bot username (no @) for the landing page link
NEXT_PUBLIC_API_URL=http://localhost:3001   # backend base URL the mini app calls from the browser

# Server-side only (used by the admin page + BFF proxies; never exposed to the browser)
BACKEND_URL=http://localhost:3001    # backend base URL; same value as NEXT_PUBLIC_API_URL
ADMIN_USER=                          # must match the backend's ADMIN_USER
ADMIN_PASSWORD=                      # must match the backend's ADMIN_PASSWORD
