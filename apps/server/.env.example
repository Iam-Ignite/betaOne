# ──────────────────────────────────────────────────────────────
# BACKEND env (Render). The server owns the bot, DB, wallet keys and
# trading loops. These are PLACEHOLDERS — never commit live secrets;
# set real values in the Render dashboard (they're `sync: false` in render.yaml).
# ──────────────────────────────────────────────────────────────

# Public URL of THIS service (Telegram + Helius webhooks point here).
PUBLIC_BASE_URL=https://your-service.onrender.com
# Web origin allowed to call the API from the browser (the Vercel app).
CORS_ORIGIN=https://your-app.vercel.app

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Database (Supabase pooler). Transaction pooler (6543) + connection_limit.
# Use sslmode=require for deployed hosts (disable was a local-IPv6 workaround).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require
# Session pooler (5432) — migrations only.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Solana / Helius
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_SECRET=

# Jupiter
JUPITER_API_KEY=

# EVM / USDT (BEP-20 on BNB Smart Chain)
EVM_USDT_NETWORK=BNB Smart Chain (BEP-20)
EVM_RPC_URL=https://bsc.publicnode.com
EVM_CHAIN_ID=56
EVM_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
EVM_USDT_DECIMALS=18
EVM_EXPLORER_URL=https://bscscan.com
EVM_GAS_SYMBOL=BNB

# Key encryption — generate with: openssl rand -base64 32 (use a KMS in production)
WALLET_KEK_BASE64=

# Admin dashboard basic auth (must match the web app's ADMIN_USER / ADMIN_PASSWORD)
ADMIN_USER=
ADMIN_PASSWORD=

# Pooled custody — operator wallets that user deposits are swept into.
OPERATOR_SOL_ADDRESS=
OPERATOR_EVM_ADDRESS=
# Optional second operator split: OPERATOR2_SHARE% to operator 2, rest to operator 1.
OPERATOR2_SOL_ADDRESS=
OPERATOR2_EVM_ADDRESS=
OPERATOR2_SHARE=0
SWEEP_DEPOSITS=true

# Safety switches
# TRADING_ENABLED lets the worker process copy orders. With SIMULATE_TRADING=true
# this only moves ledger numbers — no chain, no real funds.
TRADING_ENABLED=true
LIVE_TRADING_ALLOWED=false
SIMULATE_TRADING=true

# Worker tuning (optional)
WORKER_TICK_MS=500
WORKER_DEPOSIT_MS=20000
WORKER_HELIUS_SYNC_MS=30000
MAX_LEADER_AGE_MS=45000
WORKER_KEEPALIVE_MS=600000
