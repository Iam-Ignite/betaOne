{
  "name": "copytrade-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter server start:prod",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @copytrade/core db:generate",
    "db:push": "pnpm --filter @copytrade/core db:push",
    "db:migrate": "pnpm --filter @copytrade/core db:migrate",
    "db:deploy": "pnpm --filter @copytrade/core db:deploy",
    "set-webhook": "pnpm --filter server set-webhook",
    "create-helius-webhook": "pnpm --filter server create-helius-webhook"
  },
  "packageManager": "pnpm@9.11.0"
}
