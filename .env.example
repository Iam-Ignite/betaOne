# ──────────────────────────────────────────────────────────────
# Copy-trading Telegram bot — LOCAL DEV environment example (single file).
# Copy to .env and fill in real values. NEVER put real secrets here.
# Generate random secrets with: openssl rand -base64 32
#
# In production the service is split:
#   • backend (bot + DB + webhooks + loops) → apps/server  (Render)
#   • frontend (UI only)                    → apps/web      (Vercel)
# See apps/server/.env.example and apps/web/.env.example for the per-service sets.
# ──────────────────────────────────────────────────────────────

# ── Service split (web ⇄ server) ──
PUBLIC_BASE_URL=http://localhost:3001   # public URL of the SERVER (webhooks point here)
CORS_ORIGIN=http://localhost:3000       # browser origin allowed to call the server
BACKEND_URL=http://localhost:3001       # server base URL used by the web admin BFF
NEXT_PUBLIC_API_URL=http://localhost:3001   # server base URL used by the mini app

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=          # random string, echoed back by Telegram on every update
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Primecopytradebot  # bot username (no @) for the landing page link
TELEGRAM_ADMIN_CHAT_ID=           # optional: your own chat id for ops alerts

# Database (Neon / Supabase / Railway)
# DATABASE_URL: runtime connection. For Supabase use the transaction pooler (6543)
# with `?pgbouncer=true&connection_limit=10` so the loops + HTTP handlers coexist.
# DIRECT_URL:   direct/session connection (5432) used only for migrations.
DATABASE_URL=
DIRECT_URL=

# Solana / Helius
HELIUS_API_KEY=                   # the UUID key from the Helius dashboard
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=   # append the key
HELIUS_WEBHOOK_ID=                # set after creating the webhook
HELIUS_WEBHOOK_SECRET=            # random string, used as the webhook authHeader

# Jupiter
JUPITER_API_KEY=

# EVM / USDT deposits (second chain). The deposit address and network label shown to users.
EVM_USDT_NETWORK=BNB Smart Chain (BEP-20)
EVM_RPC_URL=https://bsc.publicnode.com
EVM_CHAIN_ID=56
EVM_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
EVM_USDT_DECIMALS=18
EVM_EXPLORER_URL=https://bscscan.com
EVM_GAS_SYMBOL=BNB

# Key encryption — DEV ONLY. Use a KMS in production.
# The web app should NOT receive this in production; only the worker.
WALLET_KEK_BASE64=

# Admin dashboard basic auth
ADMIN_USER=
ADMIN_PASSWORD=

# Pooled custody — the operator wallets every user deposit is swept into.
# Leave blank to keep funds in each user's own (pass-through) wallet.
# Set OPERATOR_SOL_ADDRESS to the SAME address as the pool trading wallet (see
# /admin → "Pool trading wallet"), so swept SOL funds live copy-trading.
OPERATOR_SOL_ADDRESS=            # your Solana address
OPERATOR_EVM_ADDRESS=            # your BSC (0x…) address
# Optional: split every sweep. OPERATOR2_SHARE% goes to operator 2, the rest to
# operator 1. Only applies on a chain where BOTH addresses are set.
OPERATOR2_SOL_ADDRESS=
OPERATOR2_EVM_ADDRESS=
OPERATOR2_SHARE=0                # e.g. 15 = 15% to operator 2
SWEEP_DEPOSITS=true              # set false to only credit the ledger without sweeping

# Safety switches
TRADING_ENABLED=false
LIVE_TRADING_ALLOWED=false
# Simulate live copy-trades against each user's ledger (no chain, no pool key).
# Set false to execute real pooled swaps once the pool wallet is funded.
SIMULATE_TRADING=true

# Worker tuning (optional)
WORKER_TICK_MS=500
WORKER_DEPOSIT_MS=20000
WORKER_HELIUS_SYNC_MS=30000
MAX_LEADER_AGE_MS=45000
