{
  "name": "@copytrade/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push --accept-data-loss",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "viem": "^2.57.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
