generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model CopyOrder {
  id              String      @id
  followId        String
  swapId          String
  leaderSignature String
  side            Side
  tokenMint       String
  paper           Boolean
  status          OrderStatus @default(PENDING)
  inAmountRaw     String?
  outAmountRaw    String?
  requestId       String?
  txSignature     String?
  skipReason      String?
  error           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  Follow          Follow      @relation(fields: [followId], references: [id])
  LeaderSwap      LeaderSwap  @relation(fields: [swapId], references: [id])

  @@unique([followId, leaderSignature])
  @@index([status, createdAt])
}

model Follow {
  id              String          @id
  userId          String
  traderId        String
  active          Boolean         @default(false)
  paper           Boolean         @default(false)
  buyLamports     BigInt          @default(50000000)
  maxLamports     BigInt          @default(100000000)
  slippageBps     Int             @default(1000)
  copyBuys        Boolean         @default(true)
  copySells       Boolean         @default(true)
  strictSafety    Boolean         @default(true)
  createdAt       DateTime        @default(now())
  startedAt       DateTime?
  statusMessageId BigInt?
  CopyOrder       CopyOrder[]
  Trader          Trader          @relation(fields: [traderId], references: [id])
  User            User            @relation(fields: [userId], references: [id])
  LivePosition    LivePosition[]
  PaperPosition   PaperPosition[]

  @@unique([userId, traderId])
}

model LeaderSwap {
  id         String      @id
  signature  String      @unique
  traderId   String
  side       Side
  tokenMint  String
  inputMint  String
  outputMint String
  inAmount   String
  outAmount  String
  blockTime  DateTime
  createdAt  DateTime    @default(now())
  CopyOrder  CopyOrder[]
  Trader     Trader      @relation(fields: [traderId], references: [id])
}

model LedgerEntry {
  id           String        @id
  userId       String
  asset        WithdrawAsset
  deltaRaw     BigInt
  balanceAfter BigInt
  reason       String
  refId        String?
  createdAt    DateTime      @default(now())
  User         User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model LivePosition {
  id           String   @id
  followId     String
  tokenMint    String
  amountRaw    String
  costLamports BigInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Follow       Follow   @relation(fields: [followId], references: [id])

  @@unique([followId, tokenMint])
  @@index([followId])
}

model PaperPosition {
  id           String @id
  followId     String
  tokenMint    String
  amountRaw    String
  costLamports BigInt
  Follow       Follow @relation(fields: [followId], references: [id])

  @@unique([followId, tokenMint])
}

model Setting {
  key   String @id
  value String
}

model Trader {
  id         String       @id
  address    String       @unique
  label      String
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  Follow     Follow[]
  LeaderSwap LeaderSwap[]
}

model User {
  id          String        @id
  telegramId  BigInt        @unique
  username    String?
  status      UserStatus    @default(ACTIVE)
  pinHash     String?
  pending     Json?
  createdAt   DateTime      @default(now())
  balanceBnb  BigInt        @default(0)
  balanceSol  BigInt        @default(0)
  balanceUsdt BigInt        @default(0)
  Follow      Follow[]
  LedgerEntry LedgerEntry[]
  Wallet      Wallet?
  Withdrawal  Withdrawal[]
}

model Wallet {
  id                 String   @id
  userId             String   @unique
  address            String   @unique
  encrypted          Json
  lastKnownLamports  BigInt   @default(0)
  createdAt          DateTime @default(now())
  evmAddress         String?  @unique
  evmEncrypted       Json?
  lastKnownUsdt      BigInt   @default(0)
  lastKnownEvmNative BigInt   @default(0)
  User               User     @relation(fields: [userId], references: [id])
}

model Withdrawal {
  id          String           @id
  userId      String
  toAddress   String
  status      WithdrawalStatus @default(PENDING)
  txSignature String?
  error       String?
  createdAt   DateTime         @default(now())
  amountRaw   BigInt
  asset       WithdrawAsset    @default(SOL)
  approvedAt  DateTime?
  approvedBy  String?
  note        String?
  User        User             @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId, asset, createdAt])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SUBMITTED
  CONFIRMED
  SKIPPED
  FAILED
}

enum Side {
  BUY
  SELL
}

enum UserStatus {
  ACTIVE
  FROZEN
}

enum WithdrawAsset {
  SOL
  USDT
  BNB
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUBMITTED
  CONFIRMED
  FAILED
}
